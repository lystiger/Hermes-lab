{
  "sprint_id": "lyscontrol-m10-compact-ui",
  "name": "LysControl M10: summary-first UI, no overlapping long text",
  "target_repo": "../",
  "target_subdir": "console",
  "base_ref": "4e06429",
  "target_branch": "hermes/lyscontrol-m10/integration",
  "worktree_root": "~/hermes-worktrees/lyscontrol-m10",
  "runs_root": "~/hermes-runs",
  "execution_backend": "subprocess",
  "limits": {
    "max_changed_files": 60,
    "timeout_seconds": 3000
  },
  "verification": [
    {
      "name": "npm-ci",
      "command": [
        "npm",
        "ci"
      ],
      "timeout_seconds": 600
    },
    {
      "name": "typecheck",
      "command": [
        "npm",
        "run",
        "typecheck"
      ],
      "timeout_seconds": 300
    },
    {
      "name": "lint",
      "command": [
        "npm",
        "run",
        "lint"
      ],
      "timeout_seconds": 300
    },
    {
      "name": "test",
      "command": [
        "npm",
        "test"
      ],
      "timeout_seconds": 600
    },
    {
      "name": "build",
      "command": [
        "npm",
        "run",
        "build"
      ],
      "timeout_seconds": 600
    }
  ],
  "phases": [
    {
      "name": "m10_builder",
      "role": "builder",
      "agent": "codex",
      "execution_backend": "subprocess",
      "worktree_dir": "builder",
      "branch": "hermes/lyscontrol-m10/builder",
      "prompt_file": "prompts/lyscontrol-m10-compact-ui-builder.md",
      "expected_handoff": "HANDOFF_BUILDER.md",
      "cmd_options": {
        "sandbox": "workspace-write",
        "ephemeral": true
      },
      "commit_message": "feat(console): summary-first overview and no overlapping long text"
    },
    {
      "name": "m10_hardener",
      "role": "hardener",
      "agent": "claude",
      "execution_backend": "subprocess",
      "worktree_dir": "hardener",
      "branch": "hermes/lyscontrol-m10/hardener",
      "prompt_file": "prompts/lyscontrol-m10-compact-ui-hardener.md",
      "expected_handoff": "HANDOFF_HARDENER.md",
      "commit_message": "fix(console): harden the compact UI"
    },
    {
      "name": "m10_verifier",
      "role": "verifier",
      "agent": "codex",
      "execution_backend": "subprocess",
      "worktree_dir": "verifier",
      "branch": "hermes/lyscontrol-m10/verifier",
      "prompt_file": "prompts/lyscontrol-m10-compact-ui-verifier.md",
      "expected_handoff": "HANDOFF_CODEX.md",
      "cmd_options": {
        "sandbox": "workspace-write",
        "ephemeral": true
      },
      "commit_message": "chore: verifier evidence only (no commit expected)"
    }
  ]
}