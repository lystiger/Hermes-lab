{
  "sprint_id": "lyscontrol-m9-stream-start",
  "name": "LysControl M9: open the event stream after the first requests settle",
  "target_repo": "../",
  "target_subdir": "console",
  "base_ref": "4e06429",
  "target_branch": "hermes/lyscontrol-m9/integration",
  "worktree_root": "~/hermes-worktrees/lyscontrol-m9",
  "runs_root": "~/hermes-runs",
  "execution_backend": "subprocess",
  "limits": {
    "max_changed_files": 40,
    "timeout_seconds": 3000
  },
  "verification": [
    { "name": "npm-ci", "command": ["npm", "ci"], "timeout_seconds": 600 },
    { "name": "typecheck", "command": ["npm", "run", "typecheck"], "timeout_seconds": 300 },
    { "name": "lint", "command": ["npm", "run", "lint"], "timeout_seconds": 300 },
    { "name": "test", "command": ["npm", "test"], "timeout_seconds": 600 },
    { "name": "build", "command": ["npm", "run", "build"], "timeout_seconds": 600 }
  ],
  "phases": [
    {
      "name": "m9_builder",
      "role": "builder",
      "agent": "codex",
      "execution_backend": "subprocess",
      "worktree_dir": "builder",
      "branch": "hermes/lyscontrol-m9/builder",
      "prompt_file": "prompts/lyscontrol-m9-stream-start-builder.md",
      "expected_handoff": "HANDOFF_BUILDER.md",
      "commit_message": "fix(console): open the event stream after the first requests settle",
      "cmd_options": { "sandbox": "workspace-write", "ephemeral": true }
    },
    {
      "name": "m9_hardener",
      "role": "hardener",
      "agent": "claude",
      "execution_backend": "subprocess",
      "worktree_dir": "hardener",
      "branch": "hermes/lyscontrol-m9/hardener",
      "prompt_file": "prompts/lyscontrol-m9-stream-start-hardener.md",
      "expected_handoff": "HANDOFF_HARDENER.md"
    },
    {
      "name": "m9_verifier",
      "role": "verifier",
      "agent": "codex",
      "execution_backend": "subprocess",
      "worktree_dir": "verifier",
      "branch": "hermes/lyscontrol-m9/verifier",
      "prompt_file": "prompts/lyscontrol-m9-stream-start-verifier.md",
      "expected_handoff": "HANDOFF_CODEX.md",
      "cmd_options": { "sandbox": "workspace-write", "ephemeral": true }
    }
  ]
}
